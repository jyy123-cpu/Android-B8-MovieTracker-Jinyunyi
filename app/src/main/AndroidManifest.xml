<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 访问 TMDb 网络接口 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13 及以上发送通知需要运行时申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机后重新注册提醒（WorkManager 本身也会持久化任务，这里用于保险） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".MovieTrackerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 通知内直接操作接收器：仅应用内部通过 PendingIntent 触发，不对外暴露 -->
        <receiver
            android:name=".reminder.ReminderActionReceiver"
            android:exported="false" />

        <!-- 开机重调度接收器：监听系统开机广播 -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 仅用于本地验证开机重调度，不影响正式开机流程 -->
                <action android:name="com.example.myapplication.action.TEST_REBOOT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
